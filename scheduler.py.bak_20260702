
import subprocess
import time
import datetime
import os

BASE_DIR = r"C:\Users\Administrator\Desktop\metatrader_tools"
BAT_FILE = os.path.join(BASE_DIR, "push_data.bat")
LOG_FILE = os.path.join(BASE_DIR, "push_data.log")
RUN_HOUR = 8

def log(msg):
    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] {msg}\n"
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(line)

def run_bat():
    log("=== Running push_data.bat ===")
    result = subprocess.run(
        ["cmd.exe", "/c", BAT_FILE],
        capture_output=True, text=True, cwd=BASE_DIR
    )
    if result.stdout:
        log("STDOUT: " + result.stdout.strip())
    if result.stderr:
        log("STDERR: " + result.stderr.strip())
    log(f"=== Done, returncode={result.returncode} ===")

log("Scheduler started/restarted")
last_run_date = None

while True:
    now = datetime.datetime.now()
    today = now.date()
    # 只要过了RUN_HOUR点，且今天还没跑过，就执行
    if now.hour >= RUN_HOUR and last_run_date != today:
        last_run_date = today
        run_bat()
    time.sleep(60)  # 每分钟检查一次
